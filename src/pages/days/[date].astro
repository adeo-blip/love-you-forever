---
import Base from '../../layouts/Base.astro';
import { days, dedication, longDate } from '../../data/site.js';
export function getStaticPaths() {
  return days.map((d) => ({ params: { date: d.date }, props: { d } }));
}
const { d } = Astro.props;
const title = `${d.title}: ${longDate(d.date)}`;
const description = `${d.women.length} women remembered with love on ${longDate(d.date)}. Short tributes built from published sources.`;
---
<Base title={title} description={description} path={`/days/${d.date}/`} datePublished={d.date}>
  <div class="wrap">
    <p class="meta"><a href="/">Home</a> · <a href="/days/">Archive</a></p>
    <h1>{d.title}</h1>
    <p class="meta">{longDate(d.date)}</p>
    <p class="lede">{d.intro}</p>
    {d.women.map((w) => (
      <section>
        <h2><a href={`/tributes/${w.slug}/`} style="color:inherit;text-decoration:none">{w.name}</a></h2>
        <p class="meta">{w.age} · {w.town}, {w.region}</p>
        {w.tribute.map((p) => <p>{p}</p>)}
        {w.example && <div class="example"><strong>Her example to the world.</strong> {w.example}</div>}
        <p class="dedication">{dedication(w.name)}</p>
        <p class="sources">Sources: {w.sources.map((s, i) => <><a href={s.url} rel="noopener nofollow" target="_blank">{s.label}</a>{i < w.sources.length - 1 ? ' · ' : ''}</>)}</p>
      </section>
    ))}
    <div class="help"><strong>If you need help.</strong> Women experiencing violence or stalking in Italy can call 1522 (free, 24 hours). In an emergency, call 112.</div>
  </div>
</Base>
